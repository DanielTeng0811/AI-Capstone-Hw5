        <terms:description xml:lang="en">This ontology models cup stacking, cutlery arrangement, and toy block collection objects as typed individuals with task roles, perception labels, pose-frame identifiers, and affordance-based graspability inference.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">Group 1 Semantic Affordance Grounding Ontology</terms:title>
        <vann:preferredNamespacePrefix>g01</vann:preferredNamespacePrefix>
