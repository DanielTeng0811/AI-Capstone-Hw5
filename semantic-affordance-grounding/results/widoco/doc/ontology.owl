        <rdfs:comment xml:lang="en">A group-authored ontology for grounding baseline AI Capstone task objects and connecting the cup-stacking final project to graspability reasoning.</rdfs:comment>
        <rdfs:label xml:lang="en">Group 1 Semantic Affordance Grounding Ontology</rdfs:label>
    </owl:Ontology>
    


